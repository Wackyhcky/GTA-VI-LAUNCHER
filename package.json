{
  "name": "game_scarlett_master",
  "productName": "Scarlett Launcher",
  "version": "1.0.2",
  "private": true,
  "description": "Unofficial novelty game launcher",
  "main": "main.js",
  "author": {
    "name": "Scarlett Novelty Works",
    "email": "hello@example.invalid"
  },
  "copyright": "\u00a9 2026 Scarlett Novelty Works. Unofficial fan project.",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.scarlettnovelty.launcher",
    "productName": "Scarlett Launcher",
    "executableName": "game_scarlett_master",
    "artifactName": "game_scarlett_master.exe",
    "copyright": "\u00a9 2026 Scarlett Novelty Works. Unofficial fan project.",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "game-finder.js",
      "preload.js",
      "config.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "All trademarks are the property of their respective owners. Unofficial fan project."
    },
    "portable": {
      "artifactName": "game_scarlett_master.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "maximum"
  }
}
